@model List<Diary>
@using Microsoft.AspNetCore.Http

<div class="max-w-5xl mx-auto p-6">

    <!-- 📝 ENTRY FORM -->
    <div class="bg-white p-6 rounded-2xl shadow mb-6">
        <h2 class="text-xl font-bold text-pink-500 mb-4">New Diary</h2>

        <form method="post" action="/Diary/Add" class="space-y-3">
            <input type="text" name="title" placeholder="Title" required
                   class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-pink-300">

            <textarea name="content" placeholder="Write your thoughts..." required
                      class="w-full p-2 border rounded-lg h-32 focus:ring-2 focus:ring-pink-300"></textarea>

            <button class="bg-pink-400 text-white px-4 py-2 rounded-lg hover:bg-pink-500">
                Add Entry
            </button>
        </form>
    </div>

    <!-- 📋 ENTRY LIST -->
    <div class="bg-white p-6 rounded-2xl shadow">
        <h2 class="text-xl font-bold text-pink-500 mb-4">Past Entries</h2>

        <table class="w-full text-sm">
            <thead>
                <tr class="text-left border-b">
                    <th class="py-2">Title</th>
                    <th>Date</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var row in Model)
                {
                    <tr class="border-b hover:bg-pink-50">
                        <td class="py-2">@row.Title</td>
                        <td>@row.EntryDate.ToString("MMM dd, yyyy")</td>

                        <td>
                            <button onclick='openModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(row)))'
                                    class="text-blue-500 hover:underline">
                                View
                            </button>
                        </td>

                        <td>
                            <a href="/Diary/Delete/@row.EntryID"
                               class="text-red-500 hover:underline"
                               onclick="return confirm('Delete this entry?')">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- 🔍 MODAL (UNCHANGED JS) -->
<div id="modal"
     class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center z-50">

    <div class="bg-white p-6 rounded-2xl w-full max-w-lg relative">

        <div class="flex justify-between items-center mb-4">
            <button onclick="enableEdit()" class="text-pink-500 text-sm font-medium">
                Edit
            </button>

            <button onclick="closeModal()" class="text-gray-500 text-xl">
                ✖
            </button>
        </div>

        <form method="post" action="/Diary/Edit" id="editForm">
            <input type="hidden" name="entryID" id="entryID">

            <input id="modalTitle" name="title" disabled
                   class="w-full text-xl font-bold mb-2 border-none outline-none">

            <input type="hidden" name="date" id="modalDateHidden">
            <input type="date" id="modalDate"
                   class="w-full border p-2 rounded mb-2 bg-gray-100" readonly
                   oninput="document.getElementById('modalDateHidden').value = this.value">

            <textarea id="modalContent" name="content" disabled
                      class="w-full border rounded-lg p-2 h-40"></textarea>

            <button name="edit" id="saveBtn"
                    class="mt-3 bg-pink-400 text-white px-4 py-2 rounded hidden">
                Save Changes
            </button>
        </form>

    </div>
</div>

<script>
        function openModal(entry) {
        document.getElementById("modal").classList.remove("hidden");

        document.getElementById("entryID").value = entry.EntryID;
        document.getElementById("modalTitle").value = entry.Title;
        document.getElementById("modalContent").value = entry.Content;

        let formattedDate = entry.EntryDate.substring(0, 10);
        document.getElementById("modalDate").value = formattedDate;
        document.getElementById("modalDateHidden").value = formattedDate;
    }

    function closeModal() {
        document.getElementById("modal").classList.add("hidden");
    }

    function enableEdit() {
        document.getElementById("modalTitle").disabled = false;
        document.getElementById("modalContent").disabled = false;
        document.getElementById("modalDate").readOnly = false;
        document.getElementById("saveBtn").classList.remove("hidden");
    }
</script>