@{
    ViewData["Title"] = "Login";
}

<div class="max-w-md mx-auto bg-white p-6 rounded-2xl shadow-md mt-6">

    <h2 class="text-2xl font-bold text-center text-pink-500 mb-4">
        Login
    </h2>

    @if (ViewBag.Error != null)
    {
        <div class="bg-red-100 text-red-600 p-2 rounded mb-3 text-sm">
            @ViewBag.Error
        </div>
    }

    <form method="post" class="space-y-4">

        <input type="email" name="email" placeholder="Student Email" required
               class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-pink-300">

        <input type="password" name="password" placeholder="Password" required
               class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-pink-300">

        <button class="w-full bg-pink-400 text-white py-2 rounded-lg hover:bg-pink-500">
            Login
        </button>
    </form>

    <p class="text-sm text-center mt-4">
        Don't have an account?
        <a href="/Auth/Register" class="text-pink-500 hover:underline">Register</a>
    </p>

</div>