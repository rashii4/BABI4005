@{
    ViewData["Title"] = "Home";
}

<div class="max-w-5xl mx-auto p-6">

    <div class="mt-8 space-y-8">

        <!-- Welcome -->
        <div class="bg-white p-6 rounded-2xl shadow">
            <h2 class="text-2xl font-bold text-pink-500 mb-2">Welcome to Restora</h2>
            <p>
                Restora helps students track diary entries, sleep logs, mood logs,
                and access mental well-being resources.
            </p>
        </div>

        <!-- About -->
        <div class="bg-white p-6 rounded-2xl shadow">
            <h2 class="text-xl font-semibold text-pink-500 mb-3">About Us</h2>

            <h3 class="font-semibold mt-2">Vision</h3>
            <p class="text-sm">
                Inspire students to prioritize well-being and create a stigma-free environment.
            </p>

            <h3 class="font-semibold mt-2">Product</h3>
            <p class="text-sm">
                A centralized platform for journaling, sleep tracking, mood logs, and resources.
            </p>

            <h3 class="font-semibold mt-2">Company</h3>
            <p class="text-sm">
                Founded in 2025 in Burnaby, BC by BCIT students.
            </p>
        </div>

        <!-- Resources -->
        <div class="bg-white p-6 rounded-2xl shadow">
            <h2 class="text-xl font-semibold text-pink-500 mb-3">Resources</h2>
            <ul class="space-y-2 text-sm">
                <li>
                    <a href="https://www.bcit.ca/recreation/" target="_blank" class="text-pink-500 hover:underline">
                        Recreation
                    </a>
                </li>
                <li>
                    <a href="https://www.bcit.ca/health-services/" target="_blank" class="text-pink-500 hover:underline">
                        Health Services
                    </a>
                </li>
                <li>
                    <a href="https://www.bcit.ca/counselling/" target="_blank" class="text-pink-500 hover:underline">
                        Counselling
                    </a>
                </li>
                <li>
                    <a href="https://www.bcit.ca/student-services/health-wellness/" target="_blank" class="text-pink-500 hover:underline">
                        Wellness
                    </a>
                </li>
            </ul>
        </div>

    </div>

</div>