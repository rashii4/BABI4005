<nav class="bg-pink-400 text-white px-6 py-4 shadow-md">
    <div class="flex justify-between items-center">

        <!-- Left: Logo + Menu -->
        <div class="flex items-center gap-6">
            <h1 class="text-xl font-bold">Restora</h1>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="flex gap-4 text-sm font-medium">
                    <a href="/" class="hover:underline">Home</a>
                    <a href="/Mood" class="hover:underline">Mood</a>
                    <a href="/Sleep" class="hover:underline">Sleep</a>
                    <a href="/Diary" class="hover:underline">Diary</a>
                    <a href="/Report" class="hover:underline">Report</a>
                </div>
            }
        </div>

        <!-- Right: Date + User -->
        <div class="flex items-center gap-4 text-sm">

            <!-- Date -->
            <span class="hidden md:block">
                @DateTime.Now.ToString("dddd, MMM dd, yyyy")
            </span>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span>
                    @User.Identity.Name
                </span>

                <a href="/Identity/Account/Logout"
                   class="bg-white text-pink-500 px-3 py-1 rounded-lg hover:bg-pink-100">
                    Sign Out
                </a>
            }
            else
            {
                <a href="/Identity/Account/Login"
                   class="hover:underline font-medium">
                    Login
                </a>

                <a href="/Identity/Account/Register"
                   class="bg-white text-pink-500 px-3 py-1 rounded-lg hover:bg-pink-100">
                    Register
                </a>
            }

        </div>
    </div>
</nav>