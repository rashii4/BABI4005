@page
@model LogoutModel

@{
    ViewData["Title"] = "Log out";
}

<div class="min-h-[70vh] flex items-center justify-center">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-lg p-8 border border-pink-100 text-center">
        <h1 class="text-3xl font-bold text-pink-500 mb-3">Log out</h1>

        <p class="text-gray-600 mb-6">
            Are you sure you want to log out of Restora?
        </p>

        <form class="space-y-4" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
            <button type="submit"
                    class="w-full rounded-xl bg-pink-500 text-white font-semibold py-3 hover:bg-pink-600 transition">
                Yes, log me out
            </button>

            <a href="/"
               class="block w-full rounded-xl border border-pink-300 text-pink-500 font-semibold py-3 hover:bg-pink-50 transition">
                Cancel
            </a>
        </form>
    </div>
</div>
